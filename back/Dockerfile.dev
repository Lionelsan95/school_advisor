# Local development image. docker-compose.yml mounts ./back over /app and runs
# `uvicorn src.interfaces.api.main:app --reload`.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Copy only the dependency manifest first so the layer caches across code edits.
COPY pyproject.toml ./
COPY src ./src

# Editable install so `src.interfaces.api.main:app` resolves regardless of the
# working directory uvicorn is started from, and so the bind mount in
# docker-compose.yml shadows the copied source without breaking imports.
RUN pip install --no-cache-dir -e ".[dev]"

EXPOSE 8000

CMD ["uvicorn", "src.interfaces.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
