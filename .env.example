# Copy to .env for local development: cp .env.example .env
# Never commit .env — it is git-ignored.

# --- Database (used by docker-compose.yml and the backend) ---
POSTGRES_USER=schools_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=schools_db

# Connection string used by the backend container. Host is the compose
# service name, not localhost.
DATABASE_URL=postgresql://schools_app:change_me_locally@db:5432/schools_db

# Same database seen from the host (spike scripts, psql, migrations run locally).
DATABASE_URL_LOCAL=postgresql://schools_app:change_me_locally@localhost:5432/schools_db

# --- External data sources (public, no credentials required) ---
ODS_BASE_URL=https://data.education.gouv.fr/api/explore/v2.1

# --- LLM provider (Phase 3 only — leave empty until AGENT-1) ---
ANTHROPIC_API_KEY=
